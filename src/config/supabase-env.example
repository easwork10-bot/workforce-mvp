// Copy this file to .env.local and replace with your actual Supabase credentials

// Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

// Optional: Service role key for server-side operations
// NEXT_PRIVATE_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

// App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

// Logging
NEXT_PUBLIC_DEBUG_LOGGING=true

// Rate limiting
NEXT_PUBLIC_RATE_LIMIT_WINDOW_MS=60000
NEXT_PUBLIC_RATE_LIMIT_MAX_ATTEMPTS=10

// File upload
NEXT_PUBLIC_MAX_FILE_SIZE_MB=10
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/pdf

// Feature flags
NEXT_PUBLIC_GPS_CHECKIN_ENABLED=false
NEXT_PUBLIC_PUSH_NOTIFICATIONS_ENABLED=true
NEXT_PUBLIC_EMAIL_NOTIFICATIONS_ENABLED=true