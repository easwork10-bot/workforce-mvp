# Supabase Configuration
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (for server-side operations, keep secret!)
# Get this from Supabase project settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Logging
NEXT_PUBLIC_DEBUG_LOGGING=true

# Rate limiting
NEXT_PUBLIC_RATE_LIMIT_WINDOW_MS=60000
NEXT_PUBLIC_RATE_LIMIT_MAX_ATTEMPTS=10

# File upload
NEXT_PUBLIC_MAX_FILE_SIZE_MB=10
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/pdf

# Feature flags
NEXT_PUBLIC_GPS_CHECKIN_ENABLED=false
NEXT_PUBLIC_PUSH_NOTIFICATIONS_ENABLED=true
NEXT_PUBLIC_EMAIL_NOTIFICATIONS_ENABLED=true