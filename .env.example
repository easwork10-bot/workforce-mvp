# Database
# Use a unique URL-safe password for a new disposable development database.
# Existing data volumes keep their initialized password; identify it before changing this value.
WORKFORCE_DEV_DB_PASSWORD=
DATABASE_URL=postgresql://postgres:${WORKFORCE_DEV_DB_PASSWORD}@127.0.0.1:${WORKFORCE_DEV_POSTGRES_PORT:-5433}/workforce
WORKFORCE_DEV_POSTGRES_PORT=5433
WORKFORCE_DEV_REDIS_PORT=6380
WORKFORCE_DEV_APP_PORT=3000

# Redis
REDIS_URL=redis://127.0.0.1:${WORKFORCE_DEV_REDIS_PORT:-6380}

# Docker Compose reads this directory on the host. Keep key files under ignored ./secrets.
WORKFORCE_SECRETS_DIR=./secrets

# JWT configuration (RS256); configure exactly one complete source:
# Option 1: Explicit file pair (e.g. Docker-mounted secrets).
# Option 2: Base64-encoded PEM pair. If neither option is set, the legacy
#           secrets/jwt_{private,public}_key.pem locations are searched; exactly
#           one complete pair must be found.
# File paths and base64 variables cannot be mixed. Partial or conflicting
# configuration, unreadable files, malformed keys, and mismatched pairs refuse
# application startup. RSA keys must be at least 2048 bits.
# Explicit file pair (paths are relative to this repository for host development):
JWT_PRIVATE_KEY_FILE=./secrets/jwt_private_key.pem
JWT_PUBLIC_KEY_FILE=./secrets/jwt_public_key.pem
# Or base64 pair:
# Generate with: openssl genpkey -algorithm RSA -out jwt_private_key.pem -pkeyopt rsa_keygen_bits:2048
#              openssl rsa -pubout -in jwt_private_key.pem -out jwt_public_key.pem
# Then base64 encode: cat jwt_private_key.pem | base64 -w 0
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=

# CSRF signing secret (required in development and production; minimum 32 bytes)
# Generate a cryptographically random value with: openssl rand -base64 48
# The Node server refuses startup if this is missing or shorter than 32 bytes.
# Rotate by replacing the secret; existing CSRF cookies will then need renewal.
# The development launcher loads this file before validating startup configuration.
# Compose does not load .env.local automatically; pass it with --env-file.
CSRF_SECRET=

# Jofra public form email delivery (server-side only; never use NEXT_PUBLIC_ prefixes)
RESEND_API_KEY=
# Verified sender mailbox on a domain configured in Resend; display name is optional.
# Example: Jofra Verkeer <noreply@your-verified-domain.nl>
JOFRA_FORMS_FROM=
# Configure the intended recipient explicitly. Use an owner-approved test mailbox
# for a controlled delivery test; automated tests never call Resend.
JOFRA_FORMS_TO=
# Comma-separated exact browser origins allowed to submit the Jofra forms.
# Configure the production custom-domain origin here; do not use a wildcard.
JOFRA_PUBLIC_ORIGINS=http://localhost:3000
# Public form abuse protection uses the Redis instance configured above.
# Public routes fail closed with HTTP 503 when Redis or a trusted request IP is unavailable.
# Framework-provided NextRequest.ip is preferred. For self-hosting behind a trusted
# proxy, set this only when that proxy strips and overwrites the selected header.
# Accepted values: x-forwarded-for or x-real-ip. Leave unset otherwise.
TRUSTED_CLIENT_IP_HEADER=
# Host Node.js uses the loopback REDIS_URL above. The app container overrides it with
# redis://redis:6379 because service DNS is only valid inside the Compose network.

# Next.js
# Use Node.js 24 LTS for host development and tests (see .nvmrc and package.json).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Argon2id parameters (memory cost 64MB, time cost 3, parallelism 2)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=2