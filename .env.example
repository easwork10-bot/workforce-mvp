# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workforce

# Redis
REDIS_URL=redis://localhost:6379

# JWT configuration (RS256); configure exactly one complete source:
# Option 1: Explicit file pair (e.g. Docker-mounted secrets).
# Option 2: Base64-encoded PEM pair. If neither option is set, the legacy
#           secrets/jwt_{private,public}_key.pem locations are searched; exactly
#           one complete pair must be found.
# File paths and base64 variables cannot be mixed. Partial or conflicting
# configuration, unreadable files, malformed keys, and mismatched pairs refuse
# application startup. RSA keys must be at least 2048 bits.
# Explicit file pair:
# JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_private_key
# JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public_key
# Or base64 pair:
# Generate with: openssl genpkey -algorithm RSA -out jwt_private_key.pem -pkeyopt rsa_keygen_bits:2048
#              openssl rsa -pubout -in jwt_private_key.pem -out jwt_public_key.pem
# Then base64 encode: cat jwt_private_key.pem | base64 -w 0
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=

# CSRF signing secret (required in development and production; minimum 32 bytes)
# Generate a cryptographically random value with: openssl rand -base64 48
# The Node server refuses startup if this is missing or shorter than 32 bytes.
# Rotate by replacing the secret; existing CSRF cookies will then need renewal.
# For Compose, set/export CSRF_SECRET before `docker compose up --build app`.
# For host development, export it before `npm run dev`.
# Example: export CSRF_SECRET="$(openssl rand -base64 48)"
# Then run `docker compose up --build app` or `npm run dev`.
CSRF_SECRET=

# Next.js
# Use Node.js 24 LTS for host development and tests (see .nvmrc and package.json).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Argon2id parameters (memory cost 64MB, time cost 3, parallelism 2)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=2