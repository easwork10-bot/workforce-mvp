# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workforce

# Redis
REDIS_URL=redis://localhost:6379

# JWT Configuration (RS256) - base64 encoded keys
# Generate with: openssl genpkey -algorithm RSA -out jwt_private_key.pem -pkeyopt rsa_keygen_bits:2048
#              openssl rsa -pubout -in jwt_private_key.pem -out jwt_public_key.pem
# Then base64 encode: cat jwt_private_key.pem | base64 -w 0
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Argon2id parameters (memory cost 64MB, time cost 3, parallelism 2)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=2